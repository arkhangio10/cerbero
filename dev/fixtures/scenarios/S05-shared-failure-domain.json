{
  "extends": "aurora.json",
  "id": "S05",
  "title": "Copies in a nested folder and in a backup folder share the volume of the project",
  "covers": ["shared-failure-domain"],
  "locations": {
    "L-bk-old": {"memberships": {"volume": "DOM-vol1"}},
    "L-nested": {"root": "projects/aurora/_versions", "memberships": {"volume": "DOM-vol1"}, "unknown_kinds": ["storage-pool", "site"]},
    "L-bk-new": null,
    "L-usb": null
  },
  "statements": {
    "STM-0001-0002": "The project folder and the backup folder are both on Volume 1. The _versions folder is inside the project."
  },
  "before": {
    "projects/aurora/_versions/brief.pdf": {"blob": "brief-v2", "mtime": 1150},
    "projects/aurora/_versions/layout.indd": {"blob": "layout-v2", "mtime": 1150},
    "projects/aurora/_versions/copy.docx": {"blob": "copy-v2", "mtime": 1150},
    "projects/aurora/_versions/cover.tif": {"blob": "cover-v2", "mtime": 1150},
    "projects/aurora/_versions/logo.ai": {"blob": "logo-v1", "mtime": 1150},
    "backups/aurora-2026-11-05/layout.indd": null,
    "backups/aurora-2026-11-05/copy.docx": null,
    "backups/aurora-2026-11-05/cover.tif": null,
    "usb-archive/aurora/brief.pdf": null,
    "usb-archive/aurora/layout.indd": null,
    "usb-archive/aurora/copy.docx": null,
    "usb-archive/aurora/cover.tif": null,
    "usb-archive/aurora/logo.ai": null
  },
  "request": {
    "intent": "what-if",
    "set": "SET-D2",
    "copy_locations": ["L-nested", "L-bk-old"],
    "member_names": ["brief.pdf", "layout.indd", "copy.docx", "cover.tif", "logo.ai"],
    "scenarios": [
      {"id": "project-folder-unavailable", "type": "location", "location": "L-proj"},
      {"id": "volume-1-failure", "type": "domain", "domain": "DOM-vol1", "named_location": "L-proj"}
    ]
  },
  "expected": {
    "whatif": [
      {"scenario": "project-folder-unavailable", "verdict": "recoverable",
       "eligible": {"A-brief": 1, "A-layout": 1, "A-copy": 1, "A-cover": 1, "A-logo": 1}},
      {"scenario": "volume-1-failure", "verdict": "not-recoverable",
       "eligible": {"A-brief": 0, "A-layout": 0, "A-copy": 0, "A-cover": 0, "A-logo": 0}}
    ]
  }
}
